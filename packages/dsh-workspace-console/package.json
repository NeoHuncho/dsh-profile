{
  "name": "dsh-workspace-console",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace Console for DeepSeek Harness: native terminals, editable per-workspace actions and keyboard chords, and per-conversation git worktree environments (.agents/env.json).",
  "type": "module",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT"
}
