{
  "name": "dsh-deepseek-auto-review",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Auto Review — Codex Guardian-style second-model approval reviewer for DeepSeek Harness",
  "type": "module",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.4.3"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs"
  },
  "files": ["lib", "src", "scripts", "README.md"],
  "license": "MIT"
}
