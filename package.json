{
  "name": "dsh-profile-web",
  "private": true,
  "scripts": {
    "postinstall": "node ./scripts/fix-pty-spawn-helper.mjs"
  },
  "dependencies": {
    "@tt-a1i/archify-dsh": "^0.1.0",
    "dsh-agent-lifecycle-cleanup": "workspace:*",
    "dsh-deepseek-auto-review": "workspace:*",
    "dsh-model-shortcuts": "workspace:*",
    "dsh-workspace-console": "workspace:*",
    "dsh-persistence-guidance": "workspace:*",
    "dsh-plugin-subscriptions": "file:./vendor/dsh-plugin-subscriptions-0.9.2-codex-websearch.tgz",
    "dsh-quick-search": "workspace:*",
    "dsh-sidebar-tray": "workspace:*",
    "dshmarket": "^1.47.0"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
