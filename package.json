{
  "name": "dsh-profile-web",
  "private": true,
  "scripts": {
    "postinstall": "node ./scripts/fix-pty-spawn-helper.mjs && node ./scripts/fix-auto-review-model-route.mjs"
  },
  "dependencies": {
    "@openviking/dsh-memory-plugin": "^0.3.2",
    "@tt-a1i/archify-dsh": "^0.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dsh-auto-review": "^0.12.4",
    "dsh-plugin-subscriptions": "^0.9.2",
    "dshmarket": "^1.47.0",
    "dsh-native-terminal": "workspace:*"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "dsh-plugin-subscriptions",
        "dshmarket",
        "dsh-auto-review",
        "@tt-a1i/archify-dsh",
        "@openviking/dsh-memory-plugin",
        "dsh-native-terminal"
      ],
      "patchReload": "live"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
